        "jsCode": "const raw = $input.item.json.text || $input.item.json.output || Object.values($input.item.json)[0];\nconst cleaned = raw.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  json: {\n    categoria: parsed.categoria,\n    urgencia: parsed.urgencia,\n    resumen: parsed.resumen,\n    borrador_respuesta: parsed.borrador_respuesta,\n    nombre_cliente: $('Email Trigger (IMAP)').all()[$itemIndex].json.from.value[0].name,\n    email_cliente: $('Email Trigger (IMAP)').all()[$itemIndex].json.from.value[0].address,\n    asunto: $('Email Trigger (IMAP)').all()[$itemIndex].json.subject,\n    cuerpo_original: $('Email Trigger (IMAP)').all()[$itemIndex].json.text,\n    thread_id: $('Email Trigger (IMAP)').all()[$itemIndex].json.messageId,\n    fecha_ingreso: $('Email Trigger (IMAP)').all()[$itemIndex].json.date\n  }\n};"
